{
  "manifest_version": 3,
  "name": "Bet-Helper 베트맨 배당 수집기",
  "version": "0.1.0",
  "description": "본인 브라우저에서 베트맨 승부식 배당을 주기적으로 읽어 Bet-Helper 앱으로 보냅니다.",
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": ["https://*.betman.co.kr/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "베트맨 배당 수집기"
  }
}
