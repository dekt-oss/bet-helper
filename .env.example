# ──────────────────────────────────────────────────────────────
# bet-helper 환경변수 예시
# 실제 값은 .env.local 에 넣으세요 (git 에 커밋되지 않습니다)
# ──────────────────────────────────────────────────────────────

# football-data.org 무료 API 키 (https://www.football-data.org/client/register)
# 무료 티어: 분당 10회 호출, 주요 대회 무료
FOOTBALL_DATA_API_KEY=

# API-Football (api-sports.io) 유료/무료 티어 키 — 선택사항
# 실시간 15초 갱신 + 배당까지 필요할 때만
API_FOOTBALL_KEY=

# 베트맨 배당 스크래핑 활성화 여부 (true/false)
# 공식 API 가 없어 HTML 파싱으로 동작하므로 사이트 구조 변경 시 깨질 수 있습니다.
ENABLE_BETMAN_SCRAPER=false

# 기본 통화/타임존
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Seoul
