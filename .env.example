# ──────────────────────────────────────────────────────────────
# bet-helper 환경변수 예시
# 실제 값은 .env.local 에 넣으세요 (git 에 커밋되지 않습니다)
# ──────────────────────────────────────────────────────────────

# football-data.org 무료 API 키 (https://www.football-data.org/client/register)
# 무료 티어: 분당 10회 호출, 주요 대회 무료
FOOTBALL_DATA_API_KEY=

# API-Football (api-sports.io) 유료/무료 티어 키 — 선택사항
# 실시간 15초 갱신 + 배당까지 필요할 때만
API_FOOTBALL_KEY=

# 베트맨 배당 스크래핑 활성화 여부 (true/false)
# 공식 API 가 없어 HTML 파싱으로 동작하므로 사이트 구조 변경 시 깨질 수 있습니다.
ENABLE_BETMAN_SCRAPER=false

# The Odds API — 월드컵 1X2 배당 자동 수집 (무료 키, 월 500회)
# https://the-odds-api.com/  → 키 발급 후 입력하면 경기별 배당이 자동 표시됩니다.
THE_ODDS_API_KEY=

# 기본 통화/타임존
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Seoul

# ── Supabase (공유 DB + 실시간) ──────────────────────────────
# 비우면 로컬 JSON(data/bets.json)으로 동작. 채우면 친구들과 공유 + 실시간 반영.
# Supabase 프로젝트 > Settings > API 에서 확인:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버에서 쓰기용(선택). 없으면 anon 키로 쓰기(위 RLS 정책이 허용).
SUPABASE_SERVICE_ROLE_KEY=

# ── 베트맨 배당 수집(크롬 확장 → /api/odds/ingest) ──────────
# 확장이 보낸 배당을 받을 때 검증하는 비밀 토큰. 길고 무작위한 값으로 설정하세요.
# 확장 옵션의 "ingest 토큰"에 동일한 값을 넣어야 합니다.
ODDS_INGEST_TOKEN=
