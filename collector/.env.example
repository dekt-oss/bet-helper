# ──────────────────────────────────────────────────────────────
# bet-helper 베트맨 수집기 환경변수 (collector/.env 로 복사해 채우세요)
# 이 파일의 실제 값(.env)은 절대 커밋되지 않습니다(.gitignore 처리됨).
# ──────────────────────────────────────────────────────────────

# 채울 값은 아래 2개뿐. (로그인은 `npm run login` 으로 창에서 직접 1회 → 세션 저장되어
#  ID/PW 를 여기 적을 필요 없음)

# 1) 앱의 ingest 주소 — 당신 앱 도메인 뒤에 /api/odds/ingest 를 붙인 풀 URL.
#    예: 앱을 https://gugubet.vercel.app 로 연다면 ↓ 처럼.
INGEST_URL=https://your-app.vercel.app/api/odds/ingest

# 2) 전송 비밀번호. ⚠️ the-odds-api 키 아님!! Vercel env 의 ODDS_INGEST_TOKEN 에
#    넣은 "그 랜덤 문자열"을 똑같이 적는다(자물쇠=앱 / 열쇠=여기).
ODDS_INGEST_TOKEN=

# ── 이하 선택값(베트맨 사이트 개편 시에만 조정) ──────────────────

# 베트맨 URL (로그인 후 승부식 배당이 보이는 페이지). 캡처가 안 되면 실제 주소로 교체.
# BETMAN_PROTO_URL=https://www.betman.co.kr/main/mainPage/gamebuy/gameBuyMain.do

# 캡처 대상 응답 URL 부분 일치(콤마 구분). 보통 비워둬도 됨 —
# 응답 본문에 compSchedules 가 있으면 자동 인식한다.
# GAMESLIP_URL_MATCH=gameSlip.do,protoMatchList.do

# 사용할 설치된 브라우저(기본: chrome→msedge 자동). 엣지만 있으면 msedge 로.
# BROWSER_CHANNEL=chrome

# 동작 옵션
HEADLESS=true            # 무인 운용은 true. 최초 로그인/디버그는 false(또는 --headful)
INTERVAL_MINUTES=12      # 수집 주기(분). 공격적 폴링 금지 — 최소 10분 권장
JITTER_SECONDS=120       # 주기에 ±랜덤 흔들기(초)
# NAV_TIMEOUT_MS=20000
# SESSION_FILE=./betman-session.json
