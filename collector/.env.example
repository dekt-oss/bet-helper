# ──────────────────────────────────────────────────────────────
# bet-helper 베트맨 수집기 환경변수 (collector/.env 로 복사해 채우세요)
# 이 파일의 실제 값(.env)은 절대 커밋되지 않습니다(.gitignore 처리됨).
# ──────────────────────────────────────────────────────────────

# 채울 값은 아래 2개뿐. (로그인은 `npm run login` 으로 창에서 직접 1회 → 세션 저장되어
#  ID/PW 를 여기 적을 필요 없음)

# 1) 앱의 ingest 주소 — 당신 앱 도메인 뒤에 /api/odds/ingest 를 붙인 풀 URL.
#    예: 앱을 https://gugubet.vercel.app 로 연다면 ↓ 처럼.
INGEST_URL=https://your-app.vercel.app/api/odds/ingest

# 2) 전송 비밀번호. ⚠️ the-odds-api 키 아님!! Vercel env 의 ODDS_INGEST_TOKEN 에
#    넣은 "그 랜덤 문자열"을 똑같이 적는다(자물쇠=앱 / 열쇠=여기).
ODDS_INGEST_TOKEN=

# ── 이하 선택값 (보통 안 건드려도 됨) ───────────────────────────

# 회차(gmTs)는 자동 탐지된다. 특정 회차로 고정하고 싶을 때만 gmTs 까지 직접 지정:
# BETMAN_PROTO_URL=https://www.betman.co.kr/main/mainPage/gamebuy/gameSlip.do?gmId=G101&gmTs=260069

# 사용할 설치된 브라우저(기본: chrome→msedge 자동). 엣지만 있으면 msedge 로.
# BROWSER_CHANNEL=chrome

# ── 수집 주기(분) ───────────────────────────────────────────
# 기본은 2시간마다, 경기 12시간 전부터는 90분마다 자주 수집한다.
BASE_INTERVAL_MINUTES=120   # 평상시 수집 간격
NEAR_INTERVAL_MINUTES=90    # 가까운 경기(아래 시간 이내)일 때 간격
NEAR_WINDOW_HOURS=12        # 경기 N시간 전부터 자주 수집
KEEPALIVE_MINUTES=25        # 세션 유지를 위한 가벼운 방문 주기(만료 지연)
JITTER_SECONDS=120          # 주기에 ±랜덤 흔들기(초)

HEADLESS=true               # 무인 운용은 true. 로그인/디버그는 false(또는 --headful)
# NAV_TIMEOUT_MS=30000
# SESSION_FILE=./betman-session.json

# ── 무중단(hang 방지) ───────────────────────────────────────
# CYCLE_TIMEOUT_SEC=210     # 한 사이클이 이 시간 넘으면 멈춤으로 보고 브라우저 강제 종료 후 회복
# MAX_FAILS=4               # 연속 hang N회면 프로세스 재시작(pm2 가 재기동)
# RESTART_HOURS=6           # N시간마다 깨끗한 재시작(메모리 누수 청소)
