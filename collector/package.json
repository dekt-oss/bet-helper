{
  "name": "bet-helper-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "베트맨 승부식 배당을 사용자 본인(가정용 IP) 환경에서 자동 수집해 bet-helper 앱으로 전송하는 헤드리스 에이전트",
  "scripts": {
    "start": "node collect.js",
    "once": "node collect.js --once",
    "capture": "node collect.js --capture-only --headful",
    "login": "node collect.js --login-only --headful"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "playwright": "1.48.0"
  }
}
